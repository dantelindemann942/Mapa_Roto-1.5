# MAPA ROTO Clip — profile for an Intel Core i7 13th Gen / 16 GB notebook.
BILLING_ENABLED=0
DISABLE_YOUTUBE_URL=true
MAX_CONCURRENT_JOBS=1
CLIP_WORKERS=1

# Faster-Whisper local, Spanish-first. Set WHISPER_LANGUAGE=auto for mixed media.
TRANSCRIBE_BACKEND=whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_LANGUAGE=es

# One multimodal model for transcript reasoning + local frame analysis.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3.5:4b
LLM_API_KEY=ollama
LLM_SCORE_BATCH=3
LLM_TIMEOUT=600
OLLAMA_BASE_URL=http://127.0.0.1:11434
VISION_PROVIDER=ollama
VISION_MODEL=qwen3.5:4b
VISION_MAX_WINDOWS=6
VISION_TIMEOUT=600

# Layout/tracking and Intel encode.
AUTO_LAYOUT=1
HOOK_GROUNDING=1
FFMPEG_ENCODER=qsv
AUTO_CAPTIONS=1

# Desktop history is deliberately durable.
JOB_RETENTION_SECONDS=31536000
OUTPUT_MAX_GB=80
UPLOADS_MAX_GB=40

